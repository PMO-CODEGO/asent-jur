    <script>
    window.openMobileMenu = function() {
        document.getElementById("menu-mobile").classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }
    window.closeMobileMenu = function() {
        document.getElementById("menu-mobile").classList.add("hidden");
        document.body.style.overflow = "";
    }

    const burgerSvgPath = 'https://www.lactalis.com.br/wp-content/themes/lactalis/assets/svg/stash_burger-arrow-left.svg';
    const closeSvgPath = 'https://www.lactalis.com.br/wp-content/themes/lactalis/assets/svg/close-button.svg';

    function setBurgerIcon() {
        fetch(burgerSvgPath)
            .then(response => response.text())
            .then(svg => {
                // Substitui o SVG mantendo o id
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = svg.trim();
                const svgEl = tempDiv.querySelector('svg');
                svgEl.setAttribute('id', 'hamburger-svg');
                const btn = document.getElementById("hamburger-menu-button");
                const oldSvg = btn.querySelector("#hamburger-svg");
                if (oldSvg) oldSvg.replaceWith(svgEl);
            });
    }

    function setCloseIcon() {
        fetch(closeSvgPath)
            .then(response => response.text())
            .then(svg => {
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = svg.trim();
                const svgEl = tempDiv.querySelector('svg');
                svgEl.setAttribute('id', 'hamburger-svg');
                const btn = document.getElementById("hamburger-menu-button");
                const oldSvg = btn.querySelector("#hamburger-svg");
                if (oldSvg) oldSvg.replaceWith(svgEl);
            });
    }

    window.toggleMobileMenu = function() {
        const menu = document.getElementById("menu-mobile");
        if (menu.classList.contains("hidden")) {
            menu.classList.remove("hidden");
            document.body.style.overflow = "hidden";
            setCloseIcon(); // Mostra o close-button.svg
        } else {
            menu.classList.add("hidden");
            document.body.style.overflow = "";
            setBurgerIcon(); // Volta para o hambúrguer
        }
    }
    window.closeMobileMenu = function() {
        document.getElementById("menu-mobile").classList.add("hidden");
        document.body.style.overflow = "";
        setBurgerIcon();
    }

    // Inicializa o ícone ao carregar a página
    document.addEventListener('DOMContentLoaded', setBurgerIcon);
    </script>

    <script>
document.addEventListener('DOMContentLoaded', function() {
    const HEADER_OFFSET = 86;
    const MARCAS_EXTRA = 120; // CORREÇÃO: Quanto MAIOR, mais desce (subtrai do offset)

    function handleAnchorScroll(target) {
        const menuMobile = document.getElementById("menu-mobile");
        if (menuMobile && !menuMobile.classList.contains("hidden")) {
            closeMobileMenu();
        }

        const el = document.querySelector(target);
        if (!el) return;

        // CORREÇÃO: Para descer MAIS, SUBTRAI o extra (offset menor = desce mais)
        const extraOffset = (target === '#nossas-marcas')
          ? (HEADER_OFFSET - MARCAS_EXTRA)
          : HEADER_OFFSET;

        const top = el.getBoundingClientRect().top + window.pageYOffset - extraOffset;
        window.scrollTo({ top, behavior: 'smooth' });
    }

    // ÚNICO MÉTODO: trata cliques em âncoras locais e links com ?scroll=
    document.querySelectorAll('a[href]').forEach(function(link) {
        link.addEventListener('click', function(e) {
            const href = link.getAttribute('href') || '';
            const isHash = href.startsWith('#');
            const isScrollParam = href.includes('?scroll=');

            if (!isHash && !isScrollParam) return;

            e.preventDefault();
            e.stopPropagation();

            const onHome = (window.location.pathname === '/' || window.location.pathname === '');
            let target = null;

            if (isHash) {
                target = href;
                if (!onHome) {
                    window.location.href = '/' + target;
                    return;
                }
                handleAnchorScroll(target);
                return;
            }

            if (isScrollParam) {
                const val = href.split('?scroll=')[1] || '';
                target = '#' + val.replace(/^#/, '');
                if (!onHome) {
                    window.location.href = '/'+ target;
                    return;
                }
                handleAnchorScroll(target);
                return;
            }
        });
    });

    history.scrollRestoration = 'manual';

    const onHome = (window.location.pathname === '/' || window.location.pathname === '');
    if (onHome) {
        let target = null;

        if (window.location.hash) {
            target = window.location.hash;
        } else {
            const params = new URLSearchParams(window.location.search);
            const scrollParam = params.get('scroll');
            if (scrollParam) target = '#' + scrollParam.replace(/^#/, '');
        }

        if (target) {
            window.scrollTo(0, 0);
            setTimeout(() => handleAnchorScroll(target), 100);
        }
    }
});
    </script>

