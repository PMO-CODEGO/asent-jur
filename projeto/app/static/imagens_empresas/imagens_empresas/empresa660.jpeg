}

/* Paginação do Swiper - CORREÇÃO para < 525px */
.swiper-pagination {
    position: relative;
    margin-top: 30px;
    margin-bottom: 20px;
    display: none;
    white-space: nowrap !important;
    overflow: visible !important;
    
    /* CORREÇÃO: Definir variáveis do Swiper para 12px */
    --swiper-pagination-bullet-size: 12px;
    --swiper-pagination-bullet-width: 12px;
    --swiper-pagination-bullet-height: 12px;
}

.swiper-pagination-bullet {
    width: 12px !important; /* CORREÇÃO: 12px em vez de 8px */
    height: 12px !important; /* CORREÇÃO: 12px em vez de 8px */
    background: #ccc;
    opacity: 1;
    display: inline-block !important;
    margin: 0 4px !important;
    cursor: pointer !important;
    transition: opacity 0.3s, transform 0.3s !important;
    border: none !important;
    outline: none !important;
    vertical-align: middle !important;
    border-radius: 50% !important; /* Garantir que seja circular */
}

.swiper-pagination-bullet:hover {
    opacity: 0.6 !important;
    transform: scale(1.1) !important;
}

.swiper-pagination-bullet-active {
    background: #004B85 !important;
    transform: scale(1.2) !important;
}

