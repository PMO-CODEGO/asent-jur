    width: 289px !important; /* Reduzido de 299px para 289px */
    height: 420px;
    flex-shrink: 0;
    margin-right: 0px;
}

.swiper-slide.noticia-slide:last-child {
    margin-right: 0 !important;
}

/* Cards de notícias - MANTIDO ORIGINAL */
.noticia-item {
    width: 278px !important;
    height: 420px;
    flex-shrink: 0;
    display: flex;
}

.noticia-card {
    width: 278px !important;
    max-width: 278px !important;
