    <style type="text/tailwindcss">
        @theme {
            --font-sans: 'Poppins', sans-serif;
            --font-magra: 'Magra', sans-serif;
            --font-inter: 'Inter', sans-serif;
            --font-poppins: 'Poppins', sans-serif;
            --color-primary: #004B85;
        }
    </style>

    <style>
    .menu-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        position: relative;
    }

    body {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        color: #004B85;
    
    }

    /* Header fixo */
    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: #ffffff;
        z-index: 100;
        box-shadow:  0 0 18px rgba(0, 0, 0, .2);
    }

    .header-logo svg {
        width: 180px;
        height: auto;
        display: block;
    }


    #nossas-marcas {
        scroll-margin-top: 200px !important;
    }

    #esg {
        scroll-margin-top: 0 !important;
    }
    #somos-lactalis {
        scroll-margin-top: 0 !important;
    }

    /* CSS específico para o header mobile - MAIS FORTE */
    .header-mobile-inner {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
        padding: 12px 0 !important;
        max-width: 1140px !important;
        margin: 0 auto !important;
        visibility: visible !important;
        opacity: 1 !important;
    }
    .social-header-mobile {
        flex-shrink: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    .social-header-mobile a {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: opacity 0.2s ease !important;
        text-decoration: none !important;
    }

    .social-header-mobile img,
    .social-header-mobile svg {
        width: 24px !important;
        height: 24px !important;
        display: block !important;
    }


    .header-hamburger-menu-button {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 32px !important;
        height: 32px !important;
        min-width: 32px !important;
        min-height: 32px !important;
        flex-shrink: 0 !important;
        background: transparent !important;
        border: none !important;
        cursor: pointer !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

   
    .header-hamburger-menu-button svg {
        width: 32px !important;
        height: 32px !important;
        display: block !important;
        fill: #004B85 !important;
        visibility: visible !important;
    }

 
    @media (max-width: 767px) {
        .header-mobile-inner {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            padding-left: 10px !important;
            padding-right: 25px !important;
            position: relative !important;
            z-index: 10 !important;
        }
        
        .social-header-mobile {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        .header-hamburger-menu-button {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            position: relative !important;
            z-index: 10 !important;
        }
        
        /* FORÇA exibição mesmo se JavaScript tentar esconder */
        .header-mobile-inner[style*="display: none"] {
            display: flex !important;
        }
        
        .social-header-mobile[style*="display: none"] {
            display: flex !important;
        }
        
        .header-hamburger-menu-button[style*="display: none"] {
            display: flex !important;
        }
    }

    @media (min-width: 768px) and (max-width: 1090px) {
        .header-mobile-inner {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            padding-right: 52px !important;
            padding-left: 42px !important;
        }
        
        .social-header-mobile {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        .header-hamburger-menu-button {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        /* FORÇA exibição mesmo se JavaScript tentar esconder */
        .header-mobile-inner[style*="display: none"] {
            display: flex !important;
        }
        
        .social-header-mobile[style*="display: none"] {
            display: flex !important;
        }
        
        .header-hamburger-menu-button[style*="display: none"] {
            display: flex !important;
        }
    }

    @media (min-width: 1091px) {
        .header-mobile-inner {
            display: none !important;
        }
        
        .social-header-mobile {
            display: none !important;
        }
        
        .header-hamburger-menu-button {
            display: none !important;
        }
    }


    * {
        -webkit-tap-highlight-color: transparent !important;
    }


    header nav a,
    header nav a:visited,
    header nav a:hover,
    header nav a:active,
    header nav a:focus,
    header nav a:link {
        text-decoration: none !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        border-bottom: none !important;
        border-top: none !important;
        text-decoration-line: none !important;
        text-decoration-color: transparent !important;
        text-underline-offset: unset !important;
        background-image: none !important;
        border-image: none !important;
    }


    header .menu-items a,
    header .menu-items a:visited,
    header .menu-items a:hover,
    header .menu-items a:active,
    header .menu-items a:focus,
    header .menu-items a:link,
    header nav a[href*="#"],
    header nav a[href*="#"]:visited,
    header nav a[href*="#"]:hover,
    header nav a[href*="#"]:active,
    header nav a[href*="#"]:focus {
        text-decoration: none !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        border-bottom: none !important;
        border-top: none !important;
        text-decoration-line: none !important;
        text-decoration-color: transparent !important;
        text-underline-offset: unset !important;
        background-image: none !important;
        border-image: none !important;
    }

    header a:-webkit-any-link {
        text-decoration: none !important;
        text-decoration-line: none !important;
        border: none !important;
        background-image: none !important;
    }

    a[href*="#nossas-marcas"],
    a[href*="#nossas-marcas"]:visited,
    a[href*="#nossas-marcas"]:hover,
    a[href*="#nossas-marcas"]:active,
    a[href*="#nossas-marcas"]:focus,
    a[href*="#esg"],
    a[href*="#esg"]:visited,
    a[href*="#esg"]:hover,
    a[href*="#esg"]:active,
    a[href*="#esg"]:focus,
    a[href*="#somos-lactalis"],
    a[href*="#somos-lactalis"]:visited,
    a[href*="#somos-lactalis"]:hover,
    a[href*="#somos-lactalis"]:active,
    a[href*="#somos-lactalis"]:focus {
        text-decoration: none !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        border-bottom: none !important;
        border-top: none !important;
        text-decoration-line: none !important;
        text-decoration-color: transparent !important;
        background-image: none !important;
        border-image: none !important;
        text-underline-offset: unset !important;
    }

    /* Remove underline do browser - GLOBAL E AGRESSIVO */
    a, 
    a:visited, 
    a:hover, 
    a:active, 
    a:focus,
    a:link {
        text-decoration: none !important;
        text-decoration-line: none !important;
        border: none !important;
        outline: none !important;
        background-image: none !important;
        border-image: none !important;
    }

    /* Remove qualquer pseudo-elemento que possa estar criando a linha */
    a::before,
    a::after,
    a:visited::before,
    a:visited::after {
        display: none !important;
        content: none !important;
        border: none !important;
        background: none !important;
    }

    /* CSS específico para elementos que podem ter :target */
    :target {
        text-decoration: none !important;
        border: none !important;
        outline: none !important;
    }    #header-main {
        width: 100%;
        max-width: 1920px;
        margin-left: auto;
        margin-right: auto;
        box-sizing: border-box;
        padding-left: 50px;
        padding-right: 20px;
    }
    @media (max-width: 1920px) {
        #header-main {
            padding-left: 50px;
            padding-right: 20px;
        }
    }
    @media (max-width: 600px) {
        #header-main {
            padding-left: 16px;
            padding-right: 16px;
        }
    }
    .container-header {
        width: 100%;
      
        margin: 0 auto;
        padding-left: 52px;
        padding-right: 52px;
        box-sizing: border-box;
    }
    
    .container-header-flex {
        display: flex;
        align-items: center;
    }
    .header-logo-desktop {
        flex-shrink: 0;
    }
    .nav-center {
        flex: 1 1 0%;
        display: flex;
        justify-content: center;
        gap: 28px;
        margin-left: -90px;
    }
    .social-header {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Responsivo: só aplica em telas grandes */
    @media (max-width: 1090px) {
      #container-header {
        display: none;
      }
    }

    @media (max-width: 767px) {
  #menu-mobile a {
    font-size: 16px !important;
    
  }
}
    /* CORREÇÃO: Melhora performance do scroll touch em cards/sliders */
    .swiper-container,
    .swiper-wrapper,
