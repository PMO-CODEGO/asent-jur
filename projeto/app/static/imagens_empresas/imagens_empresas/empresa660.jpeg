.carousel-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
}

/* SWIPER CUSTOMIZATION - IGUAL MARCAS */
.swiper.noticias-swiper {
    width: 100%;
    padding: 10px 0 30px 0;
    touch-action: pan-y pinch-zoom;
}

.swiper-wrapper.noticias-wrapper {
    display: flex;
    transition-timing-function: ease-out;
    pointer-events: auto;
}

