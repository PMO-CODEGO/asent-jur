    <style>
    /* Remove scroll-behavior: auto que está bloqueando */
    html {
        scroll-behavior: smooth !important;
    }
    
    body {
        overflow-x: hidden;
        scroll-behavior: smooth !important;
    }
    
    #esg {
        scroll-margin-top: 100px !important;
    }
    

    
    #somos-lactalis {
        scroll-margin-top: 80px !important;
    }
    
    /* Remove inércia no mobile mas mantém smooth */
    body, html {
        -webkit-overflow-scrolling: touch !important;
    }
    </style>
    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Scroll script carregado');
        
        // Handler de clique para links âncora
        function handleAnchorClick(e) {
            const href = this.getAttribute('href');
            console.log('Link clicado:', href);
            
            if (!href) return;
            
            // Extrai o hash (#esg, #nossas-marcas, etc)
            let targetHash = href.includes('#') ? '#' + href.split('#').pop() : null;
            if (!targetHash || targetHash === '#') return;
            
            console.log('Target hash:', targetHash);
            
            // Verifica se é link interno da mesma página ou de outra página
            const currentUrl = window.location.href.split('#')[0];
            const linkUrl = href.includes('http') ? href.split('#')[0] : currentUrl;
            
            console.log('Current URL:', currentUrl);
            console.log('Link URL:', linkUrl);
            
            // Se for mesma página OU se o elemento existir na página atual
            const target = document.querySelector(targetHash);
            console.log('Target encontrado:', target);
            
            if (target) {
                e.preventDefault();
                e.stopPropagation();
                
                const headerOffset = 100;
                const elementPosition = target.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                console.log('Scrolling para:', offsetPosition);
                
                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
                
                // Atualiza URL
                if (linkUrl === currentUrl) {
                    history.pushState(null, null, targetHash);
                }
            }
        }
        
        // Aplica em todos os links com #
        function attachScrollListeners() {
            const links = document.querySelectorAll('a[href*="#"]');
            console.log('Links encontrados:', links.length);
            
            links.forEach(anchor => {
                anchor.removeEventListener('click', handleAnchorClick);
                anchor.addEventListener('click', handleAnchorClick);
            });
        }
        
        // Executa imediatamente
        attachScrollListeners();
        
        // Reaplica quando DOM mudar (menus mobile, etc)
        const observer = new MutationObserver(function() {
            attachScrollListeners();
        });
        
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
        
        // Scroll ao carregar página com hash
        if (window.location.hash) {
            console.log('Hash na URL:', window.location.hash);
            setTimeout(function() {
                const target = document.querySelector(window.location.hash);
                if (target) {
                    const headerOffset = 100;
                    const elementPosition = target.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            }, 500);
        }
    });
    </script>
    
