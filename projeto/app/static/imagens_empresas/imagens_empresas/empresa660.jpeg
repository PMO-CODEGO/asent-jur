<!-- Incluir Swiper JS -->
<script src="./LACTALIS DO BRASIL - COMERCIO, IMPORTACAO E EXPORT_files/swiper-bundle.min.js.transferir"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function initRedesSociaisSwiper() {
        const wrapper = document.querySelector('#redes-sociais-swiper #redes-sociais-wrapper');
        const swiperEl = document.querySelector('#redes-sociais-swiper');
        const instagramContent = document.getElementById('instagram-content');
        
        if (!wrapper || !swiperEl || !instagramContent) {
          
            setTimeout(initRedesSociaisSwiper, 300);
            return;
        }

        // Aguardar o Instagram feed carregar
        const instagramItems = instagramContent.querySelectorAll('.sbi_item');
        if (instagramItems.length === 0) {
           
            setTimeout(initRedesSociaisSwiper, 500);
            return;
        }

    

        // CORREÇÃO: Limpar wrapper primeiro
        wrapper.innerHTML = '';

        // CORREÇÃO: Limitar a exatos 4 cards únicos - SEMPRE 4!
        const maxCards = 4;
        const uniqueItems = [];
        const seenIds = new Set();

        // Filtrar items únicos
        for (let i = 0; i < instagramItems.length && uniqueItems.length < maxCards; i++) {
            const item = instagramItems[i];
            const itemId = item.id || item.getAttribute('data-date') || i;
            
            if (!seenIds.has(itemId)) {
                seenIds.add(itemId);
                uniqueItems.push(item);
            }
        }

        // CORREÇÃO CRÍTICA: Garantir SEMPRE 4 items
        if (uniqueItems.length < 4) {
       
            
            // Duplicar items existentes para completar 4
            const originalCount = uniqueItems.length;
            for (let i = 0; uniqueItems.length < 4; i++) {
                const itemToDuplicate = uniqueItems[i % originalCount];
                const clonedItem = itemToDuplicate.cloneNode(true);
                // Alterar ID para evitar conflito
                clonedItem.id = `${itemToDuplicate.id || 'item'}-duplicate-${i}`;
                uniqueItems.push(clonedItem);
            }
            
           
        }

        // VERIFICAÇÃO FINAL: Sempre ter exatamente 4
        if (uniqueItems.length > 4) {
            uniqueItems.length = 4; // Cortar para 4
        }

       

        // VERIFICAÇÃO CRÍTICA: Cancelar se não tiver 4
        if (uniqueItems.length !== 4) {
       
            return;
        }

        // Criar slides com cards únicos
        uniqueItems.forEach((item, index) => {
            const slide = document.createElement('div');
            slide.classList.add('swiper-slide', 'redes-sociais-slide'); // CLASSE ESPECÍFICA
            slide.id = `redes-item-${index}`;
            
            // Clonar o item do Instagram
            const clonedItem = item.cloneNode(true);
            
            // ADICIONAR CLASSE ESPECÍFICA AO ITEM
            clonedItem.classList.add('redes-sociais-item');
            
            // CORREÇÃO: Melhorar qualidade da imagem
            const imgElement = clonedItem.querySelector('img');
            const linkElement = clonedItem.querySelector('a[data-full-res], a[data-img-src-set]');
            
            if (imgElement && linkElement) {
                // Tentar usar imagem full-res primeiro
                const fullResUrl = linkElement.getAttribute('data-full-res');
                const imgSrcSet = linkElement.getAttribute('data-img-src-set');
                
                let bestImageUrl = imgElement.src; // fallback
                
                if (fullResUrl) {
                    bestImageUrl = fullResUrl;
              
                } else if (imgSrcSet) {
                    try {
                        const srcSetObj = JSON.parse(imgSrcSet.replace(/&quot;/g, '"'));
                        // Priorizar resolução alta: 640 > d > 320 > 150
                        bestImageUrl = srcSetObj['640'] || srcSetObj['d'] || srcSetObj['320'] || srcSetObj['150'] || bestImageUrl;
                       
                    } catch (e) {
                       
                    }
                }
                
                // Aplicar melhor URL
                imgElement.src = bestImageUrl;
                imgElement.srcset = ''; // Limpar srcset para evitar conflitos
                
                // Garantir carregamento
                imgElement.onload = function() {
                   
                    // Remover filtros que podem causar blur
                    this.style.filter = 'none';
                    this.style.webkitFilter = 'none';
                };
                
                imgElement.onerror = function() {
                
                };
            }
            
            slide.appendChild(clonedItem);
            wrapper.appendChild(slide);
            

        });

        // CORREÇÃO: Definir função ANTES do Swiper
        function updateDotsBasedOnScroll(swiperInstance) {
            // CORREÇÃO: Só funcionar abaixo de 525px
            if (!swiperInstance.pagination || !swiperInstance.pagination.bullets || window.innerWidth >= 525) {
                return;
            }
            
            // Obter posição atual do translate
            const currentTranslate = Math.abs(swiperInstance.getTranslate());
            const slideWidth = 289; // Largura do slide + espaçamento
            
            // Calcular qual slide está mais visível baseado na posição
            let activeSlideIndex = Math.round(currentTranslate / slideWidth);
            
            // Garantir que está dentro dos limites (0-3)
            activeSlideIndex = Math.max(0, Math.min(3, activeSlideIndex));
            
   
            
            // Atualizar bullets
            swiperInstance.pagination.bullets.forEach((bullet, index) => {
                bullet.classList.toggle('swiper-pagination-bullet-active', index === activeSlideIndex);
            });
            
            // Atualizar activeIndex
            swiperInstance.activeIndex = activeSlideIndex;
        }

        // CORREÇÃO DEFINITIVA: Usar seletores específicos
        const swiper = new Swiper('.redes-sociais-swiper', {
            slidesPerView: 'auto',
            spaceBetween: 4,
            freeMode: true,
            grabCursor: true,
            mousewheel: false,
            keyboard: false,
            
            pagination: {
                el: '.redes-sociais-pagination',
                clickable: true,
                dynamicBullets: false,
                type: 'bullets',
                renderBullet: function (index, className) {
                  
                    return '<span class="' + className + '" data-slide="' + index + '"></span>';
                }
            },
            
            on: {
                init: function() {
                  
                    
                    if (this.slides.length !== 4) {
                      
                        return;
                    }
                    
                    // CORREÇÃO: Só criar bullets se < 525px
                    if (window.innerWidth < 525) {
                        
                        
                        if (!this.pagination.bullets || this.pagination.bullets.length !== 4) {
                       
                            this.forceCreate4Bullets();
                        }
                        
                        // CORREÇÃO: Sempre começar no dot 1 (índice 0)
                        setTimeout(() => {
                            this.setTranslate(0); // Posição inicial
                            if (this.pagination.bullets && this.pagination.bullets.length > 0) {
                                // Ativar primeiro bullet
                                this.pagination.bullets.forEach((bullet, index) => {
                                    bullet.classList.toggle('swiper-pagination-bullet-active', index === 0);
                                });
                               
                            }
                        }, 100);
                    } else {
                     
                        // CORREÇÃO: Garantir que não há bullets no DOM
                        const paginationEl = document.querySelector('.redes-sociais-pagination');
                        if (paginationEl) {
                            paginationEl.innerHTML = '';
                          
                        }
                    }
                },
                
                // CORREÇÃO: Usar nova função simples
                setTranslate: function() {
                    updateDotsBasedOnScroll(this);
                },
                
                touchEnd: function() {
                    const self = this;
                    setTimeout(() => {
                        updateDotsBasedOnScroll(self);
                    }, 50);
                },
                
                transitionEnd: function() {
                    updateDotsBasedOnScroll(this);
                }
            }
        });

        // CORREÇÃO: Método melhorado com click que atualiza posição
        swiper.forceCreate4Bullets = function() {
            const paginationEl = document.querySelector('.redes-sociais-pagination');
            if (paginationEl) {
                paginationEl.innerHTML = '';
              
                
                for (let i = 0; i < 4; i++) {
                    const bullet = document.createElement('span');
                    bullet.className = 'swiper-pagination-bullet';
                    if (i === 0) bullet.classList.add('swiper-pagination-bullet-active'); // Primeiro ativo
                    bullet.setAttribute('data-slide', i);
                    bullet.addEventListener('click', function() {
                      
                        
                        // CORREÇÃO: Calcular posição exata do slide
                        const slideWidth = 289;
                        const targetPosition = -(i * slideWidth);
                        
                        swiper.setTranslate(targetPosition);
                        
                        // Atualizar bullets imediatamente
                        const allBullets = paginationEl.querySelectorAll('.swiper-pagination-bullet');
                        allBullets.forEach((b, idx) => {
                            b.classList.toggle('swiper-pagination-bullet-active', idx === i);
                        });
                        
                   
                    });
                    paginationEl.appendChild(bullet);
                }
                
                this.pagination.bullets = paginationEl.querySelectorAll('.swiper-pagination-bullet');
                
            }
        };

        // CORREÇÃO: Scroll vertical mantido
        const swiperElements = [swiperEl, document.querySelector('#carousel-wrapper')];
        swiperElements.forEach(element => {
            if (element) {
                element.addEventListener('wheel', function(e) {
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.stopImmediatePropagation();
                        const scrollAmount = e.deltaY * 2;
                        window.scrollBy(0, scrollAmount);
                        e.preventDefault();
                    }
                }, { passive: false, capture: true });
            }
        });

        // CORREÇÃO: Verificações simplificadas
        setTimeout(() => {
            if (window.innerWidth < 525) {
                const finalBullets = document.querySelectorAll('.redes-sociais-pagination .swiper-pagination-bullet');
             
                
                if (finalBullets.length !== 4) {
                  
                    swiper.forceCreate4Bullets();
                }
                
                // CORREÇÃO: Garantir que começa no dot 1
                setTimeout(() => {
                    swiper.setTranslate(0);
                    if (swiper.pagination.bullets && swiper.pagination.bullets.length > 0) {
                        swiper.pagination.bullets[0].classList.add('swiper-pagination-bullet-active');
                        
                    }
                }, 50);
            } else {
                // CORREÇÃO: Limpar bullets se viewport >= 525px
                const paginationEl = document.querySelector('.redes-sociais-pagination');
                if (paginationEl) {
                    paginationEl.innerHTML = '';
                  
                }
            }
        }, 200);

        // CORREÇÃO: Redimensionamento simplificado
        window.addEventListener('resize', () => {
            setTimeout(() => {
                const currentWidth = window.innerWidth;
               
                
                swiper.update();
                
                if (currentWidth < 525) {
                   
                    
                    setTimeout(() => {
                        const bullets = document.querySelectorAll('.redes-sociais-pagination .swiper-pagination-bullet');
                        if (bullets.length !== 4) {
                            swiper.forceCreate4Bullets();
                        }
                        
                        // Sempre voltar ao início após resize
                        swiper.setTranslate(0);
                        if (bullets.length > 0) {
                            bullets.forEach((b, idx) => {
                                b.classList.toggle('swiper-pagination-bullet-active', idx === 0);
                            });
                        }
                    }, 100);
                } else {
                 
                    // CORREÇÃO: Limpar bullets quando viewport >= 525px
                    const paginationEl = document.querySelector('.redes-sociais-pagination');
                    if (paginationEl) {
                        paginationEl.innerHTML = '';
                     
                    }
                }
            }, 100);
        });

     
    }

    // Inicialização igual notícias
    setTimeout(initRedesSociaisSwiper, 100);
   
});
</script>
<style>
