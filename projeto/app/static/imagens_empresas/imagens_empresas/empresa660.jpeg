<script src="./LACTALIS DO BRASIL - COMERCIO, IMPORTACAO E EXPORT_files/swiper-bundle.min.js.transferir"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.querySelector('.carousel-wrapper');
    const swiperEl = document.querySelector('.noticias-swiper');
    
    // CORREÇÃO: Sistema AJAX para bullets responsivos
    let currentBreakpoint = null;
    let bulletCheckInterval = null;
    
    function getCurrentBreakpoint() {
        return window.innerWidth < 525 ? 'mobile' : 'desktop';
    }
    
    function updateBulletsAjax() {
        const newBreakpoint = getCurrentBreakpoint();
        
        if (newBreakpoint !== currentBreakpoint) {
           
            currentBreakpoint = newBreakpoint;
            
            const paginationEl = document.querySelector('.swiper-pagination');
            
            if (newBreakpoint === 'mobile') {
                // MOSTRAR bullets
              
                
                if (paginationEl) {
                    paginationEl.style.display = 'block';
                    paginationEl.style.setProperty('display', 'block', 'important');
                    
                    // Se não tem bullets, criar
                    if (paginationEl.children.length === 0) {
                        
                        
                        // Simular renderBullet do Swiper
                        const totalSlides = swiper.slides.length;
                        for (let i = 0; i < totalSlides; i++) {
                            const bullet = document.createElement('span');
                            bullet.className = 'swiper-pagination-bullet';
                            bullet.setAttribute('data-slide', i);
                            bullet.addEventListener('click', function() {
                                swiper.slideTo(i);
                            });
                            paginationEl.appendChild(bullet);
                        }
                        
                        // Atualizar referência no swiper
                        swiper.pagination.bullets = paginationEl.querySelectorAll('.swiper-pagination-bullet');
                      
                    }
                    
                    // Atualizar dots após criar
                    setTimeout(() => {
                        updateDotsBasedOnCenteredSlide(swiper);
                    }, 50);
                }
            } else {
               
                
                if (paginationEl) {
                    paginationEl.style.display = 'none';
                    paginationEl.style.setProperty('display', 'none', 'important');
                    // Não limpar HTML para evitar re-criação desnecessária
                }
            }
        }
    }
    
    // Função para atualizar dots baseado no slide centralizado
    function updateDotsBasedOnCenteredSlide(swiperInstance) {
        // CORREÇÃO: Só funcionar em mobile
        if (!swiperInstance.pagination || !swiperInstance.pagination.bullets || currentBreakpoint !== 'mobile') {
            return;
        }
        
        const swiperRect = swiperInstance.el.getBoundingClientRect();
        const swiperCenter = swiperRect.left + (swiperRect.width / 2);
        
        let closestSlideIndex = 0;
        let minDistance = Infinity;
        
        // Encontrar qual slide está mais próximo do centro
        swiperInstance.slides.forEach((slide, index) => {
            const slideRect = slide.getBoundingClientRect();
            const slideCenter = slideRect.left + (slideRect.width / 2);
            const distance = Math.abs(slideCenter - swiperCenter);
            
            if (distance < minDistance) {
                minDistance = distance;
                closestSlideIndex = index;
            }
        });
        
        // Atualizar bullets
        swiperInstance.pagination.bullets.forEach((bullet, index) => {
            bullet.classList.toggle('swiper-pagination-bullet-active', index === closestSlideIndex);
        });
        
        // Atualizar activeIndex
        swiperInstance.activeIndex = closestSlideIndex;
    }
    
    // Inicializar Swiper
    const swiper = new Swiper('.noticias-swiper', {
        slidesPerView: 'auto',
        spaceBetween: 4,
        freeMode: true,
        grabCursor: true,
        mousewheel: false,
        keyboard: false,
        
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
            dynamicBullets: false,
            type: 'bullets'
        },
        
        on: {
            init: function() {
            
                
                // Inicializar sistema AJAX
                currentBreakpoint = getCurrentBreakpoint();
                updateBulletsAjax();
                
                // Iniciar monitoramento contínuo
                bulletCheckInterval = setInterval(updateBulletsAjax, 100);
            },
            
            setTranslate: function() {
                updateDotsBasedOnCenteredSlide(this);
            },
            
            touchEnd: function() {
                const self = this;
                setTimeout(() => {
                    updateDotsBasedOnCenteredSlide(self);
                }, 50);
            },
            
            transitionEnd: function() {
                updateDotsBasedOnCenteredSlide(this);
            }
        }
    });

    // CORREÇÃO: Scroll vertical
    [swiperEl, wrapper].forEach(element => {
        if (element) {
            element.addEventListener('wheel', function(e) {
                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                    e.stopImmediatePropagation();
                    const scrollAmount = e.deltaY * 2;
                    window.scrollBy(0, scrollAmount);
                    e.preventDefault();
                }
            }, { passive: false, capture: true });
        }
    });

    // Click nos cards
    document.querySelectorAll('.noticia-card').forEach(card => {
        card.addEventListener('click', function() {
            const href = this.getAttribute('data-href');
            if (href) {
                window.location.href = href;
            }
        });
    });

    // CORREÇÃO: Listeners com AJAX
    window.addEventListener('resize', () => {
        swiper.update();
        // O updateBulletsAjax será chamado automaticamente pelo interval
    });

    window.addEventListener('orientationchange', () => {
        setTimeout(() => {
            swiper.update();
            // Forçar check imediato após rotação
            updateBulletsAjax();
        }, 500);
    });

    // CORREÇÃO: Cleanup ao sair da página
    window.addEventListener('beforeunload', () => {
        if (bulletCheckInterval) {
            clearInterval(bulletCheckInterval);
        }
    });

    // CORREÇÃO: Pausar/retomar monitoramento baseado na visibilidade da página
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            if (bulletCheckInterval) {
                clearInterval(bulletCheckInterval);
            }
        } else {
            if (!bulletCheckInterval) {
                bulletCheckInterval = setInterval(updateBulletsAjax, 100);
            }
        }
    });

    // CORREÇÃO: Update inicial após carregamento completo
    setTimeout(() => {
        swiper.update();
        updateBulletsAjax();
        
        if (currentBreakpoint === 'mobile') {
            setTimeout(() => {
                updateDotsBasedOnCenteredSlide(swiper);
            }, 100);
        }
    }, 200);
});
</script>


