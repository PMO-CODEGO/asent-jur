    flex-direction: column;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
}

/* Header com título e controles - MANTIDO IGUAL */
.marcas-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 56px;
    margin-top: 50px;
    position: relative;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
}

/* Mantém apenas os estilos dos botões de navegação - MANTIDO IGUAL */
.btn-nav {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 20px;
    color: #004B85;
    transition: opacity 0.3s ease;
}

.btn-nav:hover:not(:disabled) {
    opacity: 0.7;
}

.btn-nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

/* Container do carrossel - CORRIGIDO PARA PERMITIR SCROLL */
.carousel-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
}

/* SWIPER CUSTOMIZATION - CORREÇÃO PARA SCROLL */
.swiper.marcas-swiper {
    width: 100%;
    padding: 10px 0 30px 0;
    /* CORREÇÃO: Permitir que eventos passem para o body */
    touch-action: pan-y pinch-zoom;
}

.swiper-wrapper.marcas-wrapper {
    display: flex;
    transition-timing-function: ease-out;
    /* CORREÇÃO: Não bloquear eventos */
    pointer-events: auto;
}

.swiper-slide.marca-slide {
    width: 250px !important;
    height: 280px;
    flex-shrink: 0;
    margin-right: 40px;
}

.swiper-slide.marca-slide:last-child {
    margin-right: 0 !important;
}

