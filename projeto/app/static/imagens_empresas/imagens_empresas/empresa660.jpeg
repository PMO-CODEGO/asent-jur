}

/* Indicadores de slide - MANTIDO IGUAL */
.carousel-indicators {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 30px;
    display: none;
}

.carousel-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ccc;
    border: none;
    cursor: pointer;
    transition: background 0.3s ease;
}

.carousel-indicator.active {
    background: #004B85;
}

/* Customização da paginação do Swiper */
.swiper-pagination {
    position: relative;
    margin-top: 30px;
    display: none;
}

.swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    background: #ccc;
    opacity: 1;
}

.swiper-pagination-bullet-active {
    background: #004B85;
}

/* Esconder controles padrão do Swiper */
.swiper-button-next,
.swiper-button-prev {
    display: none !important;
}

/* Mobile - MANTIDO IGUAL */
@media (max-width: 768px) {
    .nossas-marcas-container {
