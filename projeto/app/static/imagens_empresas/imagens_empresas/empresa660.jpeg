<!-- Swiper JS -->
<script src="./LACTALIS DO BRASIL - COMERCIO, IMPORTACAO E EXPORT_files/swiper-bundle.min.js.transferir"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Contar slides reais
    const totalSlides = document.querySelectorAll('.banner-home-swiper .swiper-slide').length;

    // Configuração do Swiper
    const swiperConfig = {
        speed: 800,
        spaceBetween: 0,
        pagination: {
            el: '.banner-home-pagination',
            clickable: true,
            hideOnClick: false,
            dynamicBullets: false,
        },
        watchOverflow: false,
        observer: true,
        observeParents: true,
    };

    // Só ativar loop e autoplay se tiver mais de 1 slide
    if (totalSlides > 1) {
        swiperConfig.loop = true;
        swiperConfig.autoplay = {
            delay: 5000,
            disableOnInteraction: false,
        };
    }

    const bannerSwiper = new Swiper('.banner-home-swiper', swiperConfig);

    // Forçar exibição da paginação SEMPRE
    setTimeout(function() {
        const paginationEl = document.querySelector('.banner-home-pagination');
        if (paginationEl) {
            // Se não tem bullets, criar manualmente
            if (paginationEl.children.length === 0 && totalSlides > 1) {
                for (let i = 0; i < totalSlides; i++) {
                    const bullet = document.createElement('span');
                    bullet.classList.add('swiper-pagination-bullet');
                    if (i === 0) bullet.classList.add('swiper-pagination-bullet-active');
                    bullet.addEventListener('click', function() {
                        bannerSwiper.slideTo(i);
                    });
                    paginationEl.appendChild(bullet);
                }
            }
            // Forçar exibição mesmo se tiver apenas 1 slide
            paginationEl.style.display = 'flex';
            paginationEl.style.visibility = 'visible';
            paginationEl.style.opacity = '1';
            paginationEl.classList.remove('swiper-pagination-lock');
        }
    }, 300);

    // Verificar continuamente para garantir que não seja escondido
    setInterval(function() {
        const paginationEl = document.querySelector('.banner-home-pagination');
        if (paginationEl && totalSlides > 1) {
            const computedStyle = window.getComputedStyle(paginationEl);
            if (computedStyle.display === 'none') {
                paginationEl.style.display = 'flex';
                paginationEl.style.visibility = 'visible';
                paginationEl.style.opacity = '1';
            }
        }
    }, 500);
});
</script>
