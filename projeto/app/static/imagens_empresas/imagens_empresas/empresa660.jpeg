<script src="./LACTALIS DO BRASIL - COMERCIO, IMPORTACAO E EXPORT_files/swiper-bundle.min.js.transferir"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const anteriorBtn = document.getElementById('marcas-anterior');
    const proximoBtn = document.getElementById('marcas-proximo');
    const wrapper = document.querySelector('.carousel-wrapper');
    const swiperEl = document.querySelector('.marcas-swiper');
    
    // Inicializar Swiper
    const swiper = new Swiper('.marcas-swiper', {
        slidesPerView: 'auto',
        spaceBetween: 0,
        freeMode: true,
        grabCursor: true,
        
        // Desabilitar tudo relacionado a wheel
        mousewheel: false,
        keyboard: false,
        
        // Paginação apenas para mobile
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
            dynamicBullets: true,
        }
    });

    // FUNÇÃO PARA CALCULAR SCROLL MÁXIMO
    function calculateMaxScroll() {
        const slides = document.querySelectorAll('.swiper-slide.marca-slide');
        if (slides.length === 0) return 0;
        
        const wrapperWidth = wrapper.offsetWidth;
        const lastSlide = slides[slides.length - 1];
        const contentWidth = lastSlide.offsetLeft + lastSlide.offsetWidth;
        
        return Math.max(0, contentWidth - wrapperWidth);
    }

    // FUNÇÃO PARA ATUALIZAR BOTÕES
    function updateNavigationButtons() {
        if (!anteriorBtn || !proximoBtn) return;
        
        const slides = document.querySelectorAll('.swiper-slide.marca-slide');
        if (slides.length === 0) return;
        
        const maxScroll = calculateMaxScroll();
        
        if (maxScroll <= 0) {
            anteriorBtn.disabled = true;
            proximoBtn.disabled = true;
            return;
        }
        
        const currentTranslate = Math.abs(swiper.translate);
        
        anteriorBtn.disabled = currentTranslate <= 10;
        proximoBtn.disabled = currentTranslate >= maxScroll - 10;
    }

    // CORREÇÃO: Navegação card por card
    function navigateCarousel(direction) {
        const slides = document.querySelectorAll('.swiper-slide.marca-slide');
        if (slides.length === 0) return;
        
        const slideWidth = 290; // 250px + 40px gap
        const currentTranslate = Math.abs(swiper.translate);
        const maxScroll = calculateMaxScroll();
        
        let newTranslate;
        
        if (direction === 'next') {
            // CORREÇÃO: Mover apenas 1 card (290px)
            newTranslate = Math.min(currentTranslate + slideWidth, maxScroll);
        } else {
            // CORREÇÃO: Mover apenas 1 card (290px)
            newTranslate = Math.max(currentTranslate - slideWidth, 0);
        }
        
        swiper.setTransition(400);
        swiper.setTranslate(-newTranslate);
        
        setTimeout(() => {
            swiper.update();
            updateNavigationButtons();
        }, 450);
    }

    // EVENTOS DOS BOTÕES
    if (anteriorBtn) {
        anteriorBtn.addEventListener('click', (e) => {
            e.preventDefault();
            navigateCarousel('prev');
        });
    }

    if (proximoBtn) {
        proximoBtn.addEventListener('click', (e) => {
            e.preventDefault();
            navigateCarousel('next');
        });
    }

    // CORREÇÃO: Scroll vertical com velocidade normal
    [swiperEl, wrapper].forEach(element => {
        if (element) {
            element.addEventListener('wheel', function(e) {
                // Se é scroll vertical, forçar o comportamento nativo
                if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                    // Para a propagação para o Swiper
                    e.stopImmediatePropagation();
                    
                    // CORREÇÃO: Multiplicar por 2 para scroll mais rápido/normal
                    const scrollAmount = e.deltaY * 2;
                    window.scrollBy(0, scrollAmount);
                    
                    // Previne qualquer outro comportamento
                    e.preventDefault();
                }
                // Se é scroll horizontal, deixa o Swiper cuidar
            }, { passive: false, capture: true });
        }
    });

    // Atualizar botões
    swiper.on('transitionEnd', updateNavigationButtons);
    swiper.on('touchEnd', updateNavigationButtons);
    
    // Redimensionamento
    window.addEventListener('resize', () => {
        setTimeout(() => {
            swiper.update();
            updateNavigationButtons();
        }, 100);
    });

    // Inicialização
    setTimeout(() => {
        updateNavigationButtons();
    }, 200);
});
</script>
