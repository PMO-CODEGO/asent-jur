                                        <a href="https://www.lactalis.com.br/wp-content/uploads/2026/04/Guia-de-Diversidade-Equidade-e-Inclusao-Lactalis-Brasil.pdf" class="underlinefooter" target="_blank" rel="noopener noreferrer">
                        Guia DE&amp;I
                    </a>
                </div>
            </div>
        </div>
    </div>

</footer>

<style>
.cookie-banner-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 9998;
}

.cookie-banner {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: min(396px, calc(100vw - 32px));
    padding: 0;
    background: #ffffff;
    border: 1px solid #d9e0e8;
    border-radius: 20px;
    box-shadow: 0 18px 40px rgba(0, 75, 133, 0.16);
    color: #004b85;
    z-index: 9999;
    box-sizing: border-box;
    overflow: hidden;
}

.cookie-banner[hidden],
.cookie-banner-overlay[hidden] {
    display: none !important;
}

.cookie-banner__content {
    padding: 24px 24px 24px;
}

.cookie-banner__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #005abc;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
}

.cookie-banner__close:hover {
    background: rgba(0, 90, 188, 0.08);
}

.cookie-banner__title {
    display: block;
    margin: 0 32px 12px 0;
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.1;
    color: #004b85;
}

.cookie-banner__text {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    line-height: 1.54;
    color: #004b85;
}

.cookie-banner__text a {
    color: #004b85 !important;
    text-decoration: underline !important;
    text-underline-offset: 2px;
}

.cookie-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
}

.cookie-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    padding: 11px 18px;
    border: 1px solid #004b85;
    border-radius: 30px;
    background: #004b85;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: center;
    cursor: pointer;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
}

.cookie-banner__button:hover {
    opacity: 0.8;
}

@media (max-width: 767px) {
    .cookie-banner {
        right: 16px;
        bottom: 16px;
        left: 16px;
        width: auto;
    }

    .cookie-banner__content {
        padding: 20px 20px 22px;
    }

    .cookie-banner__title {
        font-size: 18px;
    }
}
</style>

<div id="cookieBannerOverlay" class="cookie-banner-overlay" hidden=""></div>

<div id="cookieBanner" class="cookie-banner" aria-live="polite" aria-label="Aviso de cookies" hidden="">
    <button type="button" class="cookie-banner__close" aria-label="Fechar aviso de cookies" data-close-cookie-modal="">
        ×
    </button>

    <div class="cookie-banner__content">
        <span class="cookie-banner__title">Nós usamos cookies.</span>
        <p class="cookie-banner__text">
            Utilizamos cookies e tecnologias semelhantes para melhorar sua experiência, personalizar conteúdo e analisar
            nosso tráfego. Você pode aceitar todos, recusar os não essenciais ou saber mais na nossa
            <a href="https://www.lactalis.com.br/wp-content/uploads/2026/06/Politica-de-Privacidade-2026_3879.pdf">Política de Privacidade</a>.
        </p>

        <div class="cookie-banner__actions">
            <button type="button" class="cookie-banner__button" data-cookie-consent="necessary">
                APENAS NECESSÁRIOS
            </button>
            <button type="button" class="cookie-banner__button" data-cookie-consent="necessary">
                RECUSAR
            </button>
            <button type="button" class="cookie-banner__button" data-cookie-consent="all">
                ACEITAR TODOS
            </button>
        </div>
    </div>
</div>

<script>
(function() {
    var COOKIE_NAME = 'cookiesAccepted';
    var overlay = document.getElementById('cookieBannerOverlay');
    var banner = document.getElementById('cookieBanner');

    if (!overlay || !banner) {
        return;
    }

    function setCookie(name, value, days) {
        var expires = '';

        if (days) {
            var date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = '; expires=' + date.toUTCString();
        }

        document.cookie = name + '=' + value + expires + '; path=/';
    }

    function getCookie(name) {
        var match = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
        return match ? match[1] : null;
    }

    function hideBanner() {
        banner.hidden = true;
        overlay.hidden = true;
    }

    function showBanner() {
        banner.hidden = false;
        overlay.hidden = false;
    }

    function updateConsent(consentType) {
        var granted = consentType === 'all' ? 'granted' : 'denied';

        setCookie(COOKIE_NAME, consentType, 365);

        if (window.dataLayer) {
            window.dataLayer.push({ event: 'consent_updated' });
            window.dataLayer.push({
                event: 'consent_update',
                consent_type: consentType
            });
        }

        if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
                analytics_storage: granted,
                ad_storage: granted,
                ad_user_data: granted,
                ad_personalization: granted
            });
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (!getCookie(COOKIE_NAME)) {
            showBanner();
        }

        banner.querySelectorAll('[data-cookie-consent]').forEach(function(button) {
            button.addEventListener('click', function() {
                updateConsent(button.getAttribute('data-cookie-consent'));
                hideBanner();
            });
        });

        banner.querySelectorAll('[data-close-cookie-modal]').forEach(function(button) {
            button.addEventListener('click', function() {
                hideBanner();
            });
        });
    });
})();
</script>
